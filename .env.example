# Copy to .env and fill in. DATABASE_URL is required for make db-setup/ingest.

# --- PostgreSQL + pgvector (required) ---
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Note: percent-encode special chars in the password (e.g. @ -> %40)
# Used by the make targets. Docker Compose ignores this and points every service
# at its own `db` container instead (see the Compose section at the bottom).
DATABASE_URL=

# --- OpenRouter LLM (required for /api/mcq-answer; /api/retrieve works without it) ---
OPENROUTER_API_KEY=
# Primary model tried first; if it errors (credit/rate/provider), routing in
# app/llm.with_llm_fallback falls through to the comma-separated list in order.
# Free (:free) slugs work without purchased credits (rate-limited, ~50/day each;
# fallbacks add capacity). Swap in a paid slug (e.g. openai/gpt-oss-20b) once you
# add credits.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,liquid/lfm-2.5-2.6b:free
OPENROUTER_TEMPERATURE=0.2
# Caps each LLM response; keeps request size (hence credit cost) bounded.
OPENROUTER_MAX_TOKENS=4000

# --- MCQ answer source (POST /api/mcq-answer) ---
# web   = default; answers from web-search results (no frm_books needed).
# books = answer from the frm_books RAG corpus (needs make ingest).
ANSWER_MODE=web
# Web mode only: which search backend to use.
#   duckduckgo = free, keyless scrape (app/websearch.py) — works with no credits.
#   openrouter = OpenRouter's `web` plugin — richer, but needs purchased credits.
WEB_SEARCH_PROVIDER=duckduckgo
# Web mode only: how many results to pull, and domains to exclude (Q&A sites,
# forums, answer mills that show the question without a reliable explanation).
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_EXCLUDE_DOMAINS=quora.com,reddit.com,facebook.com,twitter.com,x.com,instagram.com,tiktok.com,pinterest.com,stackexchange.com,stackoverflow.com,chegg.com,coursehero.com,studocu.com,scribd.com,brainly.com,quizlet.com,numerade.com,bartleby.com,answers.yahoo.com

# --- Embeddings (must match vector(384) in sql/schema.sql) ---
# Run via fastembed (ONNX Runtime) — same model as sentence-transformers, no torch.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the ONNX model is cached. Unset = fastembed's own default. In Docker this
# is baked into the image at /opt/models; set HF_HUB_OFFLINE=1 to skip hub lookups.
EMBEDDING_CACHE_DIR=

# --- Source documents ---
BOOKS_DIR=
QUESTIONS_DIR=
DOC_YEAR=2026

# --- Question Ingestion ---
QUESTIONS_JSON_DIR=questions_dump

# --- Question fetch (POST /api/questions) ---
# Min cosine similarity for semantic topic fallback (exact matches always win).
TOPIC_MATCH_THRESHOLD=0.7

# --- Chunking (structure-aware parent-child + merge-at-source sliding window) ---
CHILD_WINDOW_SENTENCES=4
CHILD_SLIDE_SENTENCES=2
CHILD_MAX_TOKENS=400
PARENT_MAX_TOKENS=800
MIN_CHUNK_TOKENS=200

# --- Server ---
HOST=127.0.0.1
PORT=5000
DEBUG=false

# --- Streamlit UI ---
# Where the streamlit app (make ui) hits the Flask backend.
API_BASE_URL=http://127.0.0.1:5000

# --- Docker Compose (docker-compose.yml) ---
# Host dirs bind-mounted into the containers: put your source PDFs in ./books,
# and practice-question PDFs in ./questions. Override to point at your own copy.
BOOKS_HOST_DIR=./books
QUESTIONS_HOST_DIR=./questions
# Postgres container credentials (compose builds DATABASE_URL from these).
# Blank = compose falls back to its own defaults (tutor / secret / frm_rag).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=frm_rag
# Published host ports (API / UI / Postgres).
APP_PORT=5000
UI_PORT=8501
POSTGRES_PORT=5432