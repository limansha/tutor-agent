# Copy to .env and fill in. DATABASE_URL is required for make db-setup/ingest.

# --- PostgreSQL + pgvector (required) ---
# Example: postgresql://tutor:secret@127.0.0.1:5432/frm_rag
# Note: percent-encode special chars in the password (e.g. @ -> %40)
DATABASE_URL=

# --- OpenRouter LLM (required for /api/mcq-answer; /api/retrieve works without it) ---
OPENROUTER_API_KEY=
# Primary model tried first; if it errors (credit/rate/provider), routing in
# app/llm.with_llm_fallback falls through to the comma-separated list in order.
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.2
# Caps each LLM response; keeps request size (hence credit cost) bounded.
OPENROUTER_MAX_TOKENS=4000

# --- Embeddings (must match vector(384) in sql/schema.sql) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Source documents ---
BOOKS_DIR=
QUESTIONS_DIR=
DOC_YEAR=2026

# --- Question Ingestion ---
QUESTIONS_JSON_DIR=questions_dump

# --- Question fetch (POST /api/questions) ---
# Min cosine similarity for semantic topic fallback (exact matches always win).
TOPIC_MATCH_THRESHOLD=0.7

# --- Chunking (structure-aware parent-child + merge-at-source sliding window) ---
CHILD_WINDOW_SENTENCES=4
CHILD_SLIDE_SENTENCES=2
CHILD_MAX_TOKENS=400
PARENT_MAX_TOKENS=800
MIN_CHUNK_TOKENS=200

# --- Server ---
HOST=127.0.0.1
PORT=5000
DEBUG=false

# --- Streamlit UI ---
# Where the streamlit app (make ui) hits the Flask backend.
API_BASE_URL=http://127.0.0.1:5000