# Copy to .env and fill in. DATABASE_URL is required for make db-setup/ingest.

# --- PostgreSQL + pgvector (required) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Note: percent-encode special chars in the password (e.g. @ -> %40)
# Used by the make targets. Docker Compose ignores this and points every service
# at its own `db` container instead (see the Compose section at the bottom).
DATABASE_URL=postgresql://tutor:secret@localhost:5432/frm_rag

# --- OpenRouter LLM (optional) ---
# Sign up at openrouter.ai -> Keys (prefix sk-or-v1-). Without it, /api/mcq-answer
# returns 503 only if no configured provider is available.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter model used in the common Groq -> OpenRouter -> Gemini chain.
# Free (:free) slugs work without purchased credits, but OpenRouter's free quota
# is account-wide (~50/day regardless of which free model). Swap in a paid slug
# (e.g. openai/gpt-oss-20b) once you buy credits.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TEMPERATURE=0.2
# Caps each LLM response; keeps request size (hence credit cost) bounded.
OPENROUTER_MAX_TOKENS=4000

# --- Cross-provider LLM fallback chain (optional) ---
# Tried in this order for every LLM endpoint: Groq -> OpenRouter -> Gemini.
# Each provider is skipped when its key is blank. Both speak the OpenAI API, so
# app/llm/ reaches them with just a
# base_url + key (no extra SDK). Their quotas are independent of OpenRouter, so
# they keep /api/mcq-answer working when OpenRouter returns 429
# "free-models-per-day".
# Best model per provider by default (quota is account-based, not model-wise, so
# use the strongest). Slugs drift — providers retire models (Groq killed
# llama-3.3-70b-versatile in Aug 2026); swap in .env when one 404s. Must support
# structured output (response_format json_schema — the MCQ path uses it).
# Leave a key blank to disable that hop entirely (no wasted 401 round-trip).
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx   # console.groq.com -> API Keys
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx         # aistudio.google.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# --- Web search (POST /api/mcq-answer) ---
# How many results to pull, and domains to exclude (Q&A sites, forums, answer
# mills that show the question without a reliable explanation).
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_EXCLUDE_DOMAINS=quora.com,reddit.com,facebook.com,twitter.com,x.com,instagram.com,tiktok.com,pinterest.com,stackexchange.com,stackoverflow.com,chegg.com,coursehero.com,studocu.com,scribd.com,brainly.com,quizlet.com,numerade.com,bartleby.com,answers.yahoo.com

# --- Embeddings (must match vector(384) in sql/schema.sql) ---
# Run via fastembed (ONNX Runtime) — same model as sentence-transformers, no torch.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the ONNX model is cached. Unset = fastembed's own default. In Docker this
# is baked into the image at /opt/models; set HF_HUB_OFFLINE=1 to skip hub lookups.
EMBEDDING_CACHE_DIR=

# --- Source documents ---
# Local dirs holding the PDFs (gitignored). Compose bind-mounts ./books and
# ./questions into the containers; point these elsewhere to use your own copy.
# QUESTIONS_DIR is required (config.py raises at import if the var is absent);
# BOOKS_DIR may stay empty while books are not being ingested.
BOOKS_DIR=./books
QUESTIONS_DIR=./questions
DOC_YEAR=2026

# --- Question Ingestion ---
QUESTIONS_JSON_DIR=questions_dump
QUESTIONS_PARSED_DIR=questions_dump/parsed_text_files
QUESTIONS_ANNOTATED_DIR=questions_dump/annotated_text_files
QUESTIONS_JSON_FILES_DIR=questions_dump/json_files
# Ingest-path settings (provider order is shared with the MCQ path).
INGEST_MODEL=openai/gpt-oss-20b
INGEST_TEMPERATURE=0
INGEST_MAX_TOKENS=1500
INGEST_EXPLANATION_WORDS=150
INGEST_REQUEST_TIMEOUT=60
# Enable only on an always-on deployment to run three-question backfill cycles.
RUN_BACKFILL_SCHEDULER=0

# --- Question fetch (POST /api/questions) ---
# Min cosine similarity for semantic topic fallback (exact matches always win).
TOPIC_MATCH_THRESHOLD=0.7

# --- Chunking (structure-aware parent-child + merge-at-source sliding window) ---
CHILD_WINDOW_SENTENCES=4
CHILD_SLIDE_SENTENCES=2
CHILD_MAX_TOKENS=400
PARENT_MAX_TOKENS=800
MIN_CHUNK_TOKENS=200

# --- Server ---
HOST=127.0.0.1
PORT=5000
DEBUG=false

# --- Streamlit UI ---
# Where the streamlit app (make ui) hits the Flask backend.
API_BASE_URL=http://127.0.0.1:5000

# --- Docker Compose (docker-compose.yml) ---
# Host dirs bind-mounted into the containers: put your source PDFs in ./books,
# and practice-question PDFs in ./questions. Override to point at your own copy.
BOOKS_HOST_DIR=./books
QUESTIONS_HOST_DIR=./questions
# Postgres container credentials (compose builds DATABASE_URL from these).
# Blank = compose falls back to its own defaults (tutor / secret / frm_rag).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=frm_rag
# Published host ports (API / UI / Postgres).
APP_PORT=5000
UI_PORT=8501
POSTGRES_PORT=5432
